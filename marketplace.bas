10 REM AGE OF JOY CABINET MARKET
11 REM Searches archive.org for cabinet packs tagged "ageofjoy-cabinets",
12 REM lists them, lists the cabinets of the chosen pack with their metadata,
13 REM downloads the chosen cabinet and installs it after asking the player.
14 REM Standalone: owns the whole screen. C64 look: the charset comes from the
15 REM cabinet's agebasic "system-skin" (default c64), the palette from SETCOLORSPACE.
16 REM Modes (MKMODE): 0 search, 1 packs, 2 cabinets, 3 download, 4 confirm,
17 REM 5 install, 6 result, 7 fatal error (search failed / no packs).

100 SETCOLORSPACE "c64"
110 LETS MKW, MKH = SCREENWIDTH(), SCREENHEIGHT()
120 LET MKBLANK = (MKW - 1) * " "
125 LET MKLINE = (MKW - 1) * "-"
130 LET MKLW = MKW - 2
140 LETS MKLISTTOP, MKLISTBOT = 3, MAX(5, MKH - 10)
145 LETS MKSEPROW, MKINFOTOP, MKINFOBOT = MKLISTBOT + 1, MKLISTBOT + 2, MKH - 4
150 LET MKROWS = MKLISTBOT - MKLISTTOP + 1
155 LET MKTITLE = "**** AGE OF JOY CABINET MARKET ****"
156 IF LEN(MKTITLE) > MKW - 1 THEN LET MKTITLE = "** CABINET MARKET **"
160 LET MKSTEPS = ARRAY(" 1 PACKS ", " 2 CABINETS ", " 3 INSTALL ")
165 LET MKSTEPX = MAX(0, INT((MKW - 1 - (LEN(MKSTEPS[0]) + LEN(MKSTEPS[1]) + LEN(MKSTEPS[2]) + 2)) / 2))
170 LET MKSPIN = ARRAY("[*      ]", "[ *     ]", "[  *    ]", "[   *   ]", "[    *  ]", "[     * ]", "[      *]", "[     * ]", "[    *  ]", "[   *   ]", "[  *    ]", "[ *     ]")
175 LETS MKBW, MKBH = MIN(MKW - 4, 34), 7
176 LETS MKBX, MKBY = INT((MKW - 1 - MKBW) / 2), MKLISTTOP + INT((MKINFOBOT - MKLISTTOP + 1 - MKBH) / 2)
177 LET MKBIW = MKBW - 4
180 LETS MKMODE, MKSTAGE, MKPHASE, MKTICK, MKCUR = 0, 0, 0, 0, 0
185 LETS MKSEL, MKTOP, MKITEMN, MKPACKN, MKCABN = 0, 0, 0, 0, 0
186 LETS MKPACKSEL, MKPACKTOP, MKCABSEL, MKCABTOP = 0, 0, 0, 0
187 LETS MKPACK, MKCAB, MKCABNAME, MKLISTNAME = "", "", "", ""
190 CALL SETCPU(100)

200 REM initial screen: C64 blue on blue, then start the pack search
210 BGCOLOR "blue" : FGCOLOR "light_blue"
220 CLS
230 GOSUB 4710

300 REM register event handlers
310 ONEVENT ONCONTROL("JOYPAD_UP", "pressed") GOTO 2010 NAME "mkt"
320 ONEVENT ONCONTROL("JOYPAD_DOWN", "pressed") GOTO 2110 NAME "mkt"
330 ONEVENT ONCONTROL("JOYPAD_LEFT", "pressed") GOTO 2210 NAME "mkt"
340 ONEVENT ONCONTROL("JOYPAD_RIGHT", "pressed") GOTO 2310 NAME "mkt"
350 ONEVENT ONCONTROL("JOYPAD_B", "pressed") GOTO 2410 NAME "mkt"
360 ONEVENT ONCONTROL("JOYPAD_A", "pressed") GOTO 2510 NAME "mkt"
370 ONEVENT ONCONTROL("JOYPAD_Y", "pressed") GOTO 2610 NAME "mkt"
380 ONEVENT ONTIMER(0.2) GOTO 3010 NAME "mkt"
390 END

2000 REM JOYPAD_UP: previous item (pack or cabinet list)
2010 IF MKMODE = 1 || MKMODE = 2 THEN LET MKDELTA = -1 : GOSUB 5410
2020 END

2100 REM JOYPAD_DOWN: next item
2110 IF MKMODE = 1 || MKMODE = 2 THEN LET MKDELTA = 1 : GOSUB 5410
2120 END

2200 REM JOYPAD_LEFT: previous page
2210 IF MKMODE = 1 || MKMODE = 2 THEN LET MKDELTA = 0 - MKROWS : GOSUB 5410
2220 END

2300 REM JOYPAD_RIGHT: next page
2310 IF MKMODE = 1 || MKMODE = 2 THEN LET MKDELTA = MKROWS : GOSUB 5410
2320 END

2400 REM JOYPAD_B: open pack / download cabinet / confirm install / continue / retry
2410 IF MKMODE = 1 THEN GOSUB 4050
     ELSE IF MKMODE = 2 THEN GOSUB 4210
     ELSE IF MKMODE = 4 THEN GOSUB 4410
     ELSE IF MKMODE = 6 THEN GOSUB 4110
     ELSE IF MKMODE = 7 THEN GOSUB 4710
2420 END

2500 REM JOYPAD_A: back to the packs / refuse the install
2510 IF MKMODE = 2 THEN GOSUB 4010
     ELSE IF MKMODE = 4 THEN GOSUB 4460
2520 END

2600 REM JOYPAD_Y: leave the market
2610 SHUTDOWN

3000 REM ONTIMER: blinking C64 cursor + polling of the running network/install job
3010 LET MKTICK = MKTICK + 1
3020 IF MOD(MKTICK, 3) = 0 THEN LET MKCUR = 1 - MKCUR : GOSUB 5160
3030 IF MKMODE = 0 THEN GOSUB 3110
     ELSE IF MKMODE = 3 THEN GOSUB 3310
     ELSE IF MKMODE = 5 THEN GOSUB 3510
3040 SHOW
3050 END

3100 REM search poll: phase 0 waits the search, phase 1 waits every pack to load
3110 GOSUB 6310
3120 IF MKPHASE = 1 THEN GOTO 3210
3130 LET MKST = IASTATUS(MKSEARCH)
3140 IF MKST = "LOADING" THEN RETURN
3150 IF MKST != "READY" THEN LETS MKRESMSG, MKRESDETAIL = "SEARCH FAILED", "CHECK YOUR INTERNET CONNECTION" : GOSUB 4610 : RETURN
3160 LET MKPACKS = IAPACKS(MKSEARCH)
3170 LET MKPACKN = LEN(MKPACKS)
3180 IF MKPACKN = 0 THEN LETS MKRESMSG, MKRESDETAIL = "NO PACKS FOUND", "NO AGEOFJOY-CABINETS PACKS YET" : GOSUB 4610 : RETURN
3185 FOR MKI = 0 TO MKPACKN - 1
3190   LET MKID = IALOAD(MKPACKS[MKI])
3195 NEXT MKI
3200 LET MKPHASE = 1 : RETURN
3210 LET MKLOADING = 0
3220 FOR MKI = 0 TO MKPACKN - 1
3230   IF IASTATUS(MKPACKS[MKI]) = "LOADING" THEN LET MKLOADING = MKLOADING + 1
3240 NEXT MKI
3250 LETS MKBR, MKBT, MKBC = 1, "READING PACK " + STR(MKPACKN - MKLOADING) + " OF " + STR(MKPACKN), "white" : GOSUB 6110
3260 IF MKLOADING > 0 THEN RETURN
3270 GOSUB 4010
3280 RETURN

3300 REM download poll: progress bar, then confirm (zip waiting) or already installed
3310 LET MKDS = IADOWNLOADSTATUS(MKPACK, MKCAB)
3320 LET MKPCT = IADOWNLOADPROGRESS(MKPACK, MKCAB) : GOSUB 6210
3330 IF MKDS = "QUEUED" || MKDS = "DOWNLOADING" THEN RETURN
3340 IF MKDS = "COMPLETED" THEN GOTO 3370
3350 LETS MKRESTITLE, MKRESMSG, MKRESCOL, MKRESDETAIL = " ERROR ", "DOWNLOAD FAILED", "light_red", "CHECK YOUR CONNECTION" : GOSUB 4510
3360 RETURN
3370 IF FILEEXISTS(COMBINEPATH(CABINETSPATH(), MKCAB)) = 1 THEN GOSUB 4310 : RETURN
3380 LETS MKRESTITLE, MKRESMSG, MKRESCOL, MKRESDETAIL = " DONE ", "ALREADY INSTALLED", "light_green", "THIS CABINET IS UP TO DATE" : GOSUB 4510
3390 RETURN

3500 REM install poll: the poll that sees the end registers the cabinet in the DB
3510 GOSUB 6310
3520 LET MKIS = CABDBINSTALLSTATUS(MKCAB)
3530 IF MKIS = "INSTALLING" THEN RETURN
3540 IF MKIS = "INSTALLED" THEN LETS MKRESTITLE, MKRESMSG, MKRESCOL, MKRESDETAIL = " SUCCESS ", "INSTALLED!", "light_green", "READY TO USE IN YOUR ROOMS" : GOSUB 4510 : RETURN
3550 LETS MKRESTITLE, MKRESMSG, MKRESCOL, MKRESDETAIL = " ERROR ", "INSTALL FAILED", "light_red", "THE CABINET ZIP IS NOT VALID" : GOSUB 4510
3560 RETURN

4000 REM enter PACKS mode (mode 1), restoring the last pack selection
4010 LETS MKMODE, MKSTAGE, MKSEL, MKTOP = 1, 0, MKPACKSEL, MKPACKTOP
4020 GOSUB 5510
4025 LET MKLISTNAME = STR(MKPACKN) + " PACKS FOUND"
4030 LETS MKGUIDE, MKKEYS = "PICK A PACK TO SEE ITS CABINETS", "UP/DN:MOVE  <>:PAGE  B:OPEN  Y:EXIT"
4040 GOSUB 4910
4045 RETURN

4049 REM open the highlighted pack (B in mode 1)
4050 IF MKITEMN = 0 THEN RETURN
4060 LET MKID = MKPACKS[MKSEL]
4070 IF IASTATUS(MKID) != "READY" THEN LET MKGUIDE = "PACK NOT AVAILABLE, PICK ANOTHER" : GOSUB 5110 : SHOW : RETURN
4080 IF IAINFO(MKID, "count") = 0 THEN LET MKGUIDE = "THIS PACK IS EMPTY, PICK ANOTHER" : GOSUB 5110 : SHOW : RETURN
4090 LETS MKPACK, MKPACKSEL, MKPACKTOP, MKCABSEL, MKCABTOP = MKID, MKSEL, MKTOP, 0, 0
4095 GOSUB 4110
4100 RETURN

4105 REM enter CABINETS mode (mode 2) for MKPACK, restoring MKCABSEL/MKCABTOP
4110 LETS MKMODE, MKSTAGE, MKSEL, MKTOP = 2, 1, MKCABSEL, MKCABTOP
4120 GOSUB 5710
4125 IF MKSEL > MKITEMN - 1 THEN LETS MKSEL, MKTOP = 0, 0
4130 LET MKLISTNAME = UCASE(IAINFO(MKPACK, "title"))
4135 IF TRIM(MKLISTNAME) = "" THEN LET MKLISTNAME = UCASE(MKPACK)
4140 LETS MKGUIDE, MKKEYS = "PICK A CABINET TO DOWNLOAD IT", "UP/DN:MOVE <>:PAGE B:GET A:BACK Y:EXIT"
4150 GOSUB 4910
4160 RETURN

4200 REM start the download of the highlighted cabinet (B in mode 2)
4210 IF MKITEMN = 0 THEN RETURN
4220 LETS MKCABSEL, MKCABTOP, MKCAB = MKSEL, MKTOP, MKCABS[MKSEL]
4230 LET MKCABNAME = UCASE(IACABINFO(MKPACK, MKCAB, "name"))
4235 LET MKSZ = IACABINFO(MKPACK, MKCAB, "size") : GOSUB 5910
4240 LET MKDLNAME = IADOWNLOAD(MKPACK, MKCAB)
4250 LETS MKMODE, MKSTAGE = 3, 2 : GOSUB 5010
4260 LET MKBOXTITLE = " DOWNLOADING " : GOSUB 6010
4270 LETS MKBR, MKBT, MKBC = 1, MKCABNAME, "white" : GOSUB 6110
4275 LETS MKBR, MKBT, MKBC = 2, MKSZTXT, "grey" : GOSUB 6110
4280 LET MKPCT = 0 : GOSUB 6210
4285 LETS MKGUIDE, MKKEYS = "DOWNLOADING FROM ARCHIVE.ORG", "PLEASE WAIT...  Y:EXIT" : GOSUB 5110
4290 SHOW
4300 RETURN

4305 REM ask permission to install (mode 4)
4310 LET MKMODE = 4
4320 LET MKBOXTITLE = " INSTALL? " : GOSUB 6010
4330 LETS MKBR, MKBT, MKBC = 1, "DOWNLOAD COMPLETE", "light_green" : GOSUB 6110
4340 LETS MKBR, MKBT, MKBC = 2, "INSTALL " + MKCABNAME + "?", "white" : GOSUB 6110
4350 LETS MKBR, MKBT, MKBC = 4, "B:YES      A:NO", "yellow" : GOSUB 6110
4360 LETS MKGUIDE, MKKEYS = "INSTALL THE CABINET NOW?", "B:YES  A:NO  Y:EXIT" : GOSUB 5110
4370 SHOW
4380 RETURN

4400 REM install granted (B in mode 4); CABDBINSTALL throws without the zip, check first
4410 IF FILEEXISTS(COMBINEPATH(CABINETSPATH(), MKCAB)) = 0 THEN LETS MKRESTITLE, MKRESMSG, MKRESCOL, MKRESDETAIL = " ERROR ", "INSTALL FAILED", "light_red", "THE DOWNLOAD IS MISSING" : GOSUB 4510 : RETURN
4420 CALL CABDBINSTALL(MKCAB)
4430 LET MKMODE = 5 : LET MKBOXTITLE = " INSTALLING " : GOSUB 6010
4440 LETS MKBR, MKBT, MKBC = 1, MKCABNAME, "white" : GOSUB 6110
4445 LETS MKBR, MKBT, MKBC = 2, "UNPACKING...", "grey" : GOSUB 6110
4450 LETS MKGUIDE, MKKEYS = "INSTALLING, PLEASE WAIT", "PLEASE WAIT...  Y:EXIT" : GOSUB 5110
4455 SHOW
4458 RETURN

4459 REM install refused (A in mode 4): discard the zip so it isn't auto-installed on next start
4460 CALL FILEDELETE(COMBINEPATH(CABINETSPATH(), MKCAB))
4465 LETS MKRESTITLE, MKRESMSG, MKRESCOL, MKRESDETAIL = " CANCELLED ", "NOT INSTALLED", "orange", "THE DOWNLOAD WAS DISCARDED"
4470 GOSUB 4510
4475 RETURN

4500 REM result box (mode 6): MKRESTITLE, MKRESMSG, MKRESCOL, MKRESDETAIL
4510 LET MKMODE = 6 : LET MKBOXTITLE = MKRESTITLE : GOSUB 6010
4520 LETS MKBR, MKBT, MKBC = 1, MKCABNAME, "white" : GOSUB 6110
4530 LETS MKBR, MKBT, MKBC = 3, MKRESMSG, MKRESCOL : GOSUB 6110
4540 LETS MKBR, MKBT, MKBC = 4, MKRESDETAIL, "light_grey" : GOSUB 6110
4550 LETS MKGUIDE, MKKEYS = "PRESS B TO PICK ANOTHER CABINET", "B:CONTINUE  Y:EXIT" : GOSUB 5110
4560 SHOW
4570 RETURN

4600 REM fatal box (mode 7): search failed or nothing found, B retries
4610 LET MKMODE = 7 : LET MKBOXTITLE = " ERROR " : GOSUB 6010
4620 LETS MKBR, MKBT, MKBC = 2, MKRESMSG, "light_red" : GOSUB 6110
4630 LETS MKBR, MKBT, MKBC = 3, MKRESDETAIL, "light_grey" : GOSUB 6110
4640 LETS MKGUIDE, MKKEYS = "PRESS B TO SEARCH AGAIN", "B:RETRY  Y:EXIT" : GOSUB 5110
4650 SHOW
4660 RETURN

4700 REM start (or restart) the pack search (mode 0)
4710 LETS MKMODE, MKSTAGE, MKPHASE, MKPACKSEL, MKPACKTOP = 0, 0, 0, 0, 0
4720 LET MKSEARCH = IASEARCH("")
4730 GOSUB 5010 : GOSUB 5210
4735 FGCOLOR "light_blue" : PRINT 0, MKH - 3, MKLINE, 0, 0
4740 LET MKBOXTITLE = " ARCHIVE.ORG " : GOSUB 6010
4750 LETS MKBR, MKBT, MKBC = 1, "SEARCHING CABINET PACKS", "white" : GOSUB 6110
4755 GOSUB 6310
4760 LETS MKGUIDE, MKKEYS = "LOOKING FOR PACKS ON ARCHIVE.ORG", "PLEASE WAIT...  Y:EXIT" : GOSUB 5110
4770 SHOW
4780 RETURN

4900 REM full redraw of a list screen (modes 1 and 2)
4910 GOSUB 5010 : GOSUB 5210
4920 GOSUB 5310
4930 IF MKMODE = 1 THEN GOSUB 5610 ELSE GOSUB 5810
4940 FGCOLOR "light_blue" : PRINT 0, MKH - 3, MKLINE, 0, 0
4950 GOSUB 5110
4960 SHOW
4970 RETURN

5000 REM banner (row 0), step breadcrumb (row 1) and separator (row 2)
5010 FGCOLOR "light_blue" : PRINT 0, 0, MKBLANK, 1, 0
5020 PRINT INT((MKW - 1 - LEN(MKTITLE)) / 2), 0, MKTITLE, 1, 0
5030 PRINT 0, 1, MKBLANK, 0, 0 : LET MKC = MKSTEPX
5040 FOR MKI = 0 TO 2
5050   IF MKI = MKSTAGE THEN FGCOLOR "yellow" : PRINT MKC, 1, MKSTEPS[MKI], 1, 0
       ELSE FGCOLOR IIF(MKI < MKSTAGE, "light_green", "grey") : PRINT MKC, 1, MKSTEPS[MKI], 0, 0
5060   LET MKC = MKC + LEN(MKSTEPS[MKI])
5070   IF MKI < 2 THEN FGCOLOR "grey" : PRINT MKC, 1, ">", 0, 0 : LET MKC = MKC + 1
5080 NEXT MKI
5090 FGCOLOR "light_blue" : PRINT 0, 2, MKLINE, 0, 0
5095 RETURN

5100 REM guide line (row H-2, yellow) and key footer (row H-1, inverted)
5110 FGCOLOR "yellow" : PRINT 0, MKH - 2, MKBLANK, 0, 0
5120 PRINT 0, MKH - 2, SUBSTR(MKGUIDE, 0, MKW - 3), 0, 0
5130 FGCOLOR "light_blue" : PRINT 0, MKH - 1, MKBLANK, 1, 0
5140 PRINT 0, MKH - 1, SUBSTR(" " + MKKEYS, 0, MKW - 1), 1, 0
5150 RETURN

5155 REM blinking C64 block cursor right after the guide text
5160 FGCOLOR "light_blue" : PRINT MIN(LEN(MKGUIDE), MKW - 3) + 1, MKH - 2, " ", MKCUR, 0
5170 RETURN

5200 REM clear the content area (rows 3..H-3)
5210 FOR MKR = MKLISTTOP TO MKH - 3
5220   PRINT 0, MKR, MKBLANK, 0, 0
5230 NEXT MKR
5240 RETURN

5245 REM clear the info panel
5250 FOR MKR = MKINFOTOP TO MKINFOBOT
5255   PRINT 0, MKR, MKBLANK, 0, 0
5258 NEXT MKR
5259 RETURN

5260 REM info row: cyan label MKLBL + value MKVAL in MKVALCOL at row MKLR
5265 FGCOLOR "cyan" : PRINT 0, MKLR, MKLBL, 0, 0
5270 FGCOLOR MKVALCOL : PRINT LEN(MKLBL), MKLR, SUBSTR(MKVAL, 0, MKW - 1 - LEN(MKLBL)), 0, 0
5280 FGCOLOR "light_blue"
5290 RETURN

5300 REM draw the visible window of the list (MKITEMS/MKTAGS/MKTAGCOL, MKSEL, MKTOP)
5310 FOR MKR = 0 TO MKROWS - 1
5320   LET MKIDX = MKTOP + MKR
5330   IF MKIDX < MKITEMN THEN GOSUB 5360 ELSE PRINT 0, MKLISTTOP + MKR, SUBSTR(MKBLANK, 0, MKLW + 1), 0, 0
5340 NEXT MKR
5345 FGCOLOR "white" : PRINT MKLW, MKLISTTOP, IIF(MKTOP > 0, "^", " "), 0, 0
5350 PRINT MKLW, MKLISTBOT, IIF(MKTOP + MKROWS < MKITEMN, "v", " "), 0, 0
5355 GOSUB 5390
5358 RETURN

5359 REM one list row: selected = inverted yellow bar with ">", others = text + colored tag
5360 LET MKTAG = MKTAGS[MKIDX]
5365 LET MKTXT = SUBSTR(MKITEMS[MKIDX] + MKBLANK, 0, MKLW - 2 - LEN(MKTAG))
5370 IF MKIDX = MKSEL THEN FGCOLOR "yellow" : PRINT 0, MKLISTTOP + MKR, ">" + MKTXT + " " + MKTAG, 1, 0
     ELSE FGCOLOR "light_blue" : PRINT 0, MKLISTTOP + MKR, " " + MKTXT + " ", 0, 0 : FGCOLOR MKTAGCOL[MKIDX] : PRINT MKLW - LEN(MKTAG), MKLISTTOP + MKR, MKTAG, 0, 0
5380 FGCOLOR "light_blue"
5385 RETURN

5389 REM separator under the list: list name on the left, position on the right
5390 FGCOLOR "light_blue" : PRINT 0, MKSEPROW, MKLINE, 0, 0
5392 FGCOLOR "white" : PRINT 1, MKSEPROW, SUBSTR(" " + MKLISTNAME + " ", 0, MKW - 12), 0, 0
5394 IF MKITEMN > 0 THEN LET MKPOS = " " + STR(MKSEL + 1) + "/" + STR(MKITEMN) + " " : PRINT MKW - 2 - LEN(MKPOS), MKSEPROW, MKPOS, 0, 0
5396 FGCOLOR "light_blue"
5398 RETURN

5400 REM move the selection by MKDELTA, scroll the window, refresh list + info
5410 IF MKITEMN = 0 THEN RETURN
5420 LET MKSEL = MAX(0, MIN(MKITEMN - 1, MKSEL + MKDELTA))
5430 IF MKSEL < MKTOP THEN LET MKTOP = MKSEL
5440 IF MKSEL >= MKTOP + MKROWS THEN LET MKTOP = MKSEL - MKROWS + 1
5450 GOSUB 5310
5460 IF MKMODE = 1 THEN GOSUB 5610 ELSE GOSUB 5810
5470 SHOW
5480 RETURN

5500 REM build the pack list: title + "n CABS", or identifier + status if not READY
5510 DIM MKITEMS[MAX(MKPACKN, 1)]
5515 DIM MKTAGS[MAX(MKPACKN, 1)]
5520 DIM MKTAGCOL[MAX(MKPACKN, 1)]
5525 LET MKITEMN = MKPACKN
5530 IF MKPACKN = 0 THEN RETURN
5535 FOR MKI = 0 TO MKPACKN - 1
5540   LET MKID = MKPACKS[MKI] : LET MKST = IASTATUS(MKID)
5550   IF MKST = "READY" THEN LET MKITEMS[MKI] = UCASE(IAINFO(MKID, "title")) : LET MKTAGS[MKI] = STR(IAINFO(MKID, "count")) + " CABS" : LET MKTAGCOL[MKI] = "light_green"
       ELSE LET MKITEMS[MKI] = UCASE(MKID) : LET MKTAGS[MKI] = MKST : LET MKTAGCOL[MKI] = "light_red"
5560   IF TRIM(MKITEMS[MKI]) = "" THEN LET MKITEMS[MKI] = UCASE(MKID)
5570 NEXT MKI
5580 RETURN

5600 REM pack info panel
5610 GOSUB 5250
5615 IF MKITEMN = 0 THEN RETURN
5620 LET MKID = MKPACKS[MKSEL] : LET MKST = IASTATUS(MKID)
5630 LETS MKLBL, MKVAL, MKVALCOL, MKLR = "PACK : ", UCASE(MKID), "white", MKINFOTOP : GOSUB 5265
5640 IF MKST != "READY" THEN GOTO 5680
5650 LETS MKLBL, MKVAL, MKVALCOL, MKLR = "CABS : ", STR(IAINFO(MKID, "count")) + " CABINETS", "light_green", MKINFOTOP + 1 : GOSUB 5265
5660 LET WRAPTEXT = IAINFO(MKID, "description")
5665 IF TRIM(WRAPTEXT) = "" THEN LET WRAPTEXT = "(NO DESCRIPTION)"
5670 LETS MKWRAPTOP, MKWRAPCOL = MKINFOTOP + 2, "light_grey" : GOSUB 7410
5675 RETURN
5680 LETS MKLBL, MKVAL, MKVALCOL, MKLR = "STATE: ", MKST, "light_red", MKINFOTOP + 1 : GOSUB 5265
5690 LET WRAPTEXT = IIF(MKST = "PROCESSING", "ARCHIVE.ORG IS STILL PROCESSING THIS PACK. TRY AGAIN LATER.", IIF(MKST = "DARK", "THIS PACK WAS TAKEN DOWN FROM ARCHIVE.ORG.", "THIS PACK COULD NOT BE READ FROM ARCHIVE.ORG."))
5695 LETS MKWRAPTOP, MKWRAPCOL = MKINFOTOP + 2, "light_grey" : GOSUB 7410
5698 RETURN

5700 REM build the cabinet list of MKPACK: name + NEW / OWNED / UPDATE tag
5710 LET MKCABS = IACABS(MKPACK) : LET MKCABN = LEN(MKCABS)
5715 DIM MKITEMS[MAX(MKCABN, 1)]
5720 DIM MKTAGS[MAX(MKCABN, 1)]
5725 DIM MKTAGCOL[MAX(MKCABN, 1)]
5730 LET MKITEMN = MKCABN
5735 IF MKCABN = 0 THEN RETURN
5740 FOR MKI = 0 TO MKCABN - 1
5745   LET MKITEMS[MKI] = UCASE(IACABINFO(MKPACK, MKCABS[MKI], "name"))
5750   LET MKDL = IACABINFO(MKPACK, MKCABS[MKI], "downloaded")
5760   IF MKDL = 1 THEN LET MKTAGS[MKI] = "OWNED" : LET MKTAGCOL[MKI] = "grey"
       ELSE IF MKDL = 2 THEN LET MKTAGS[MKI] = "UPDATE" : LET MKTAGCOL[MKI] = "orange"
       ELSE LET MKTAGS[MKI] = "NEW" : LET MKTAGCOL[MKI] = "light_green"
5770 NEXT MKI
5780 RETURN

5800 REM cabinet info panel: name, size, state, description
5810 GOSUB 5250
5815 IF MKITEMN = 0 THEN RETURN
5820 LET MKCAB = MKCABS[MKSEL]
5830 LETS MKLBL, MKVAL, MKVALCOL, MKLR = "NAME : ", MKITEMS[MKSEL], "white", MKINFOTOP : GOSUB 5265
5840 LET MKSZ = IACABINFO(MKPACK, MKCAB, "size") : GOSUB 5910
5845 LETS MKLBL, MKVAL, MKVALCOL, MKLR = "SIZE : ", MKSZTXT, "white", MKINFOTOP + 1 : GOSUB 5265
5850 LET MKDL = IACABINFO(MKPACK, MKCAB, "downloaded")
5855 LETS MKLBL, MKVAL, MKVALCOL, MKLR = "STATE: ", IIF(MKDL = 1, "ALREADY DOWNLOADED", IIF(MKDL = 2, "UPDATE AVAILABLE", "NOT DOWNLOADED YET")), MKTAGCOL[MKSEL], MKINFOTOP + 2 : GOSUB 5265
5860 LET WRAPTEXT = IACABINFO(MKPACK, MKCAB, "description")
5865 IF TRIM(WRAPTEXT) = "" THEN LET WRAPTEXT = "(NO DESCRIPTION)"
5870 LETS MKWRAPTOP, MKWRAPCOL = MKINFOTOP + 3, "light_grey" : GOSUB 7410
5880 RETURN

5900 REM format MKSZ (bytes) into MKSZTXT ("2.6 MB" / "512 KB")
5910 IF MKSZ >= 1048576 THEN LET MKSZTXT = STR(INT(MKSZ / 1048576)) + "." + STR(INT(MOD(INT(MKSZ), 1048576) * 10 / 1048576)) + " MB"
     ELSE LET MKSZTXT = STR(INT(MKSZ / 1024)) + " KB"
5920 RETURN

6000 REM centered dialog box with a solid C64 frame, drop shadow and MKBOXTITLE
6010 FGCOLOR "light_blue" : PRINT MKBX, MKBY, SUBSTR(MKBLANK, 0, MKBW), 1, 0
6020 FOR MKR = 1 TO MKBH - 2
6030   PRINT MKBX, MKBY + MKR, " ", 1, 0
6040   PRINT MKBX + 1, MKBY + MKR, SUBSTR(MKBLANK, 0, MKBW - 2), 0, 0
6050   PRINT MKBX + MKBW - 1, MKBY + MKR, " ", 1, 0
6060 NEXT MKR
6070 PRINT MKBX, MKBY + MKBH - 1, SUBSTR(MKBLANK, 0, MKBW), 1, 0
6075 FGCOLOR "black"
6080 FOR MKR = 1 TO MKBH
6085   PRINT MKBX + MKBW, MKBY + MKR, " ", 1, 0
6090 NEXT MKR
6095 PRINT MKBX + 1, MKBY + MKBH, SUBSTR(MKBLANK, 0, MKBW), 1, 0
6100 FGCOLOR "light_blue" : PRINT MKBX + INT((MKBW - LEN(MKBOXTITLE)) / 2), MKBY, MKBOXTITLE, 1, 0
6105 RETURN

6106 REM centered box text MKBT in color MKBC at box row MKBR (1..MKBH-2)
6110 PRINT MKBX + 2, MKBY + MKBR, SUBSTR(MKBLANK, 0, MKBIW), 0, 0
6120 LET MKBT = SUBSTR(MKBT, 0, MKBIW)
6130 FGCOLOR MKBC : PRINT MKBX + INT((MKBW - LEN(MKBT)) / 2), MKBY + MKBR, MKBT, 0, 0
6140 FGCOLOR "light_blue"
6150 RETURN

6200 REM progress bar on box row 3 (MKPCT 0..100) + percentage on row 4
6210 LET MKFILL = INT(MAX(0, MIN(100, MKPCT)) * MKBIW / 100)
6220 FGCOLOR "darkgrey" : PRINT MKBX + 2, MKBY + 3, SUBSTR(MKBLANK, 0, MKBIW), 1, 0
6230 IF MKFILL > 0 THEN FGCOLOR "light_green" : PRINT MKBX + 2, MKBY + 3, SUBSTR(MKBLANK, 0, MKFILL), 1, 0
6240 LETS MKBR, MKBT, MKBC = 4, STR(INT(MAX(0, MIN(100, MKPCT)))) + "%", "white" : GOSUB 6110
6250 RETURN

6300 REM bouncing spinner on box row 3
6310 LETS MKBR, MKBT, MKBC = 3, MKSPIN[MOD(MKTICK, LEN(MKSPIN))], "light_green" : GOSUB 6110
6320 RETURN

7400 REM word-wrap WRAPTEXT (uppercased) from row MKWRAPTOP down to MKINFOBOT in MKWRAPCOL
7410 FGCOLOR MKWRAPCOL : LETS MKWROW, MKWLINE = MKWRAPTOP, ""
7415 LET WRAPTEXT = UCASE(WRAPTEXT)
7420 LET MKWCOUNT = COUNTMEMBERS(WRAPTEXT, " ")
7430 IF MKWCOUNT = 0 THEN GOTO 7490
7440 FOR MKWI = 0 TO MKWCOUNT - 1
7450   LET MKWORD = GETMEMBER(WRAPTEXT, MKWI, " ")
7460   LET MKWCAND = IIF(MKWLINE = "", MKWORD, MKWLINE + " " + MKWORD)
7470   IF LEN(MKWCAND) <= MKW - 1 THEN LET MKWLINE = MKWCAND ELSE GOSUB 7520 : LET MKWLINE = MKWORD
7480 NEXT MKWI
7490 IF MKWLINE != "" THEN GOSUB 7520
7500 FGCOLOR "light_blue"
7510 RETURN

7515 REM flush MKWLINE to row MKWROW and advance; no-op past the info panel
7520 IF MKWROW > MKINFOBOT THEN RETURN
7530 PRINT 0, MKWROW, SUBSTR(MKWLINE, 0, MKW - 1), 0, 0
7540 LET MKWROW = MKWROW + 1
7550 RETURN
