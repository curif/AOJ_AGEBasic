10 REM AGE OF JOY ROM SHOP
11 REM Downloads ROM zips from hardcoded archive.org items into DOWNLOADSPATH(),
12 REM the folder game.bas picks ROMs from. One live screen, no wizard:
13 REM LEFT/RIGHT walk a 0-9/A-Z index (empty letters are skipped), UP/DOWN walk the
14 REM ROMs of that letter (stepping past the ends jumps to the next/previous letter),
15 REM B queues a download that runs in the background while browsing continues.
16 REM Add more items to RSIDS, with the folder that holds their zips in RSPREFIX.
17 REM Modes (RSMODE): 0 loading item, 1 browsing, 2 item error, 3 exit warning.

100 SETCOLORSPACE "c64"
110 LETS RSW, RSH = SCREENWIDTH(), SCREENHEIGHT()
120 LETS RSBLANK, RSLINE = (RSW - 1) * " ", (RSW - 1) * "-"
130 LETS RSLISTTOP, RSLISTBOT = 4, MAX(6, RSH - 8)
140 LETS RSSEPROW, RSINFOTOP, RSINFOBOT = RSLISTBOT + 1, RSLISTBOT + 2, RSH - 4
150 LETS RSROWS, RSLW = RSLISTBOT - RSLISTTOP + 1, RSW - 2
155 LET RSTITLE = "****  AGE OF JOY ROM SHOP  ****"
156 IF LEN(RSTITLE) > RSW - 1 THEN LET RSTITLE = "** ROM SHOP **"
160 LET RSIDX = "0123456789ABCDEFGHIJKLMNOPQRSTUVWXYZ"
165 LET RSIDXN = LEN(RSIDX)
170 LET RSSPIN = ARRAY("[=      ]", "[==     ]", "[ ==    ]", "[  ==   ]", "[   ==  ]", "[    == ]", "[     ==]", "[      =]", "[       ]")
175 LET RSIDS = ARRAY("mame-2003-plus-reference-set")
176 LET RSPREFIX = ARRAY("roms/", "")
177 LET RSSRCN = LEN(RSIDS)
180 LETS RSBW, RSBH = MIN(RSW - 4, 32), 6
181 LETS RSBX, RSBY = INT((RSW - 1 - RSBW) / 2), RSLISTTOP + MAX(0, INT((RSINFOBOT - RSLISTTOP + 1 - RSBH) / 2))
182 LET RSBIW = RSBW - 4
185 LETS RSMODE, RSSRC, RSLET, RSSEL, RSTOP, RSCNT, RSTOTAL, RSATEND = 0, 0, 0, 0, 0, 0, 0, 0
186 LETS RSTICK, RSCUR, RSMSGT, RSQN, RSQMAX = 0, 0, 0, 0, 32
187 LETS RSMSG, RSMSGCOL, RSFAILED, RSID, RSPFX, RSGUIDE, RSKEYS = "", "white", "", "", "", "", ""
188 DIM RSLCNT[RSIDXN]
189 DIM RSQID[RSQMAX]
190 DIM RSQFILE[RSQMAX]
191 DIM RSQNAME[RSQMAX]
192 DIM RSDL[1]
193 REM files bigger than RSMAXSZ (2 GB) are left out of the list
194 LET RSMAXSZ = 2147483648
195 CALL SETCPU(100)

200 REM C64 blue on blue, then read the first item
210 BGCOLOR "blue" : FGCOLOR "light_blue"
220 CLS
230 GOSUB 4010

300 REM register event handlers
310 ONEVENT ONCONTROL("JOYPAD_UP", "pressed") GOTO 2010 NAME "rsh"
315 ONEVENT ONCONTROL("JOYPAD_DOWN", "pressed") GOTO 2110 NAME "rsh"
320 ONEVENT ONCONTROL("JOYPAD_LEFT", "pressed") GOTO 2210 NAME "rsh"
325 ONEVENT ONCONTROL("JOYPAD_RIGHT", "pressed") GOTO 2310 NAME "rsh"
330 ONEVENT ONCONTROL("JOYPAD_L", "pressed") GOTO 2410 NAME "rsh"
335 ONEVENT ONCONTROL("JOYPAD_R", "pressed") GOTO 2510 NAME "rsh"
340 ONEVENT ONCONTROL("JOYPAD_X", "pressed") GOTO 2610 NAME "rsh"
345 ONEVENT ONCONTROL("JOYPAD_B", "pressed") GOTO 2710 NAME "rsh"
350 ONEVENT ONCONTROL("JOYPAD_Y", "pressed") GOTO 2810 NAME "rsh"
355 ONEVENT ONCONTROL("JOYPAD_A", "pressed") GOTO 2910 NAME "rsh"
360 ONEVENT ONTIMER(0.25) GOTO 3010 NAME "rsh"
390 END

2000 REM JOYPAD_UP: previous ROM (or the last ROM of the previous letter)
2010 IF RSMODE = 3 THEN GOSUB 4910
     ELSE IF RSMODE = 1 THEN LET RSDELTA = -1 : GOSUB 5510
2020 END

2100 REM JOYPAD_DOWN: next ROM (or the first ROM of the next letter)
2110 IF RSMODE = 3 THEN GOSUB 4910
     ELSE IF RSMODE = 1 THEN LET RSDELTA = 1 : GOSUB 5510
2120 END

2200 REM JOYPAD_LEFT: previous letter with ROMs
2210 IF RSMODE = 3 THEN GOSUB 4910
     ELSE IF RSMODE = 1 THEN LET RSDIR = -1 : GOSUB 4310
2220 END

2300 REM JOYPAD_RIGHT: next letter with ROMs
2310 IF RSMODE = 3 THEN GOSUB 4910
     ELSE IF RSMODE = 1 THEN LET RSDIR = 1 : GOSUB 4310
2320 END

2400 REM JOYPAD_L: page up
2410 IF RSMODE = 3 THEN GOSUB 4910
     ELSE IF RSMODE = 1 THEN LET RSDELTA = 0 - RSROWS : GOSUB 5510
2420 END

2500 REM JOYPAD_R: page down
2510 IF RSMODE = 3 THEN GOSUB 4910
     ELSE IF RSMODE = 1 THEN LET RSDELTA = RSROWS : GOSUB 5510
2520 END

2600 REM JOYPAD_X: next source item (only when there is more than one)
2610 IF RSMODE = 3 THEN GOSUB 4910
     ELSE IF RSSRCN > 1 && (RSMODE = 1 || RSMODE = 2) THEN LET RSSRC = MOD(RSSRC + 1, RSSRCN) : GOSUB 4010
2620 END

2700 REM JOYPAD_B: download the highlighted ROM / retry the item
2710 IF RSMODE = 3 THEN GOSUB 4910
     ELSE IF RSMODE = 1 THEN GOSUB 4510
     ELSE IF RSMODE = 2 THEN GOSUB 4010
2720 END

2800 REM JOYPAD_Y: leave; with downloads running, ask first (second Y leaves)
2810 IF RSMODE = 1 && RSQN > 0 THEN GOSUB 4810 : GOTO 2830
2820 SHUTDOWN
2830 END

2900 REM JOYPAD_A: only dismisses the exit warning
2910 IF RSMODE = 3 THEN GOSUB 4910
2920 END

3000 REM ONTIMER: item loading, download queue, message timeout, blinking cursor
3010 LET RSTICK = RSTICK + 1
3020 IF RSMSGT > 0 THEN LET RSMSGT = RSMSGT - 1
3030 IF RSMODE = 0 THEN GOSUB 3110
3040 IF RSQN > 0 THEN GOSUB 3310
3050 IF MOD(RSTICK, 2) = 0 THEN LET RSCUR = 1 - RSCUR
3060 GOSUB 5810
3070 SHOW
3080 END

3100 REM item load poll
3110 GOSUB 6310
3120 LET RSST = IASTATUS(RSID)
3130 IF RSST = "LOADING" THEN RETURN
3140 IF RSST = "READY" THEN GOSUB 4110 : RETURN
3150 LET RSERR = RSST : GOSUB 4710
3160 RETURN

3300 REM download queue poll: retire one finished download per tick, refresh the view
3310 LET RSDONE = -1
3320 FOR RSQ = 0 TO RSQN - 1
3330   LET RSQS = IAFILEDOWNLOADSTATUS(RSQID[RSQ], RSQFILE[RSQ])
3340   IF RSQS != "QUEUED" && RSQS != "DOWNLOADING" THEN LET RSDONE = RSQ : GOTO 3360
3350 NEXT RSQ
3360 IF RSDONE >= 0 THEN GOSUB 3410
3370 IF RSMODE = 1 THEN GOSUB 5310 : GOSUB 5710
3375 IF RSMODE = 3 THEN GOSUB 4850
3380 RETURN

3400 REM retire queue entry RSDONE (final status in RSQS)
3410 IF RSQS = "COMPLETED" THEN LETS RSMSG, RSMSGCOL = RSQNAME[RSDONE] + " DOWNLOADED", "light_green"
     ELSE LETS RSMSG, RSMSGCOL = RSQNAME[RSDONE] + " FAILED", "light_red" : LET RSFAILED = ADDMEMBER(RSFAILED, RSQID[RSDONE] + ":" + RSQFILE[RSDONE], "|")
3420 LET RSMSGT = 12
3430 IF RSQID[RSDONE] = RSID THEN GOSUB 5210
3440 IF RSDONE >= RSQN - 1 THEN GOTO 3480
3450 FOR RSQ = RSDONE TO RSQN - 2
3460   LETS RSQID[RSQ], RSQFILE[RSQ], RSQNAME[RSQ] = RSQID[RSQ + 1], RSQFILE[RSQ + 1], RSQNAME[RSQ + 1]
3470 NEXT RSQ
3480 LET RSQN = RSQN - 1
3490 RETURN

4000 REM select source RSSRC: build it if already read, otherwise read it (mode 0)
4010 LETS RSID, RSPFX = RSIDS[RSSRC], ""
4015 IF RSSRC < LEN(RSPREFIX) THEN LET RSPFX = RSPREFIX[RSSRC]
4020 LET RSST = IASTATUS(RSID)
4030 IF RSST = "READY" THEN GOSUB 4110 : RETURN
4040 IF RSST != "LOADING" THEN LET RSID = IALOAD(RSID)
4050 LETS RSMODE, RSTOTAL = 0, 0
4060 GOSUB 5010 : GOSUB 5250
4070 LET RSBOXT = " ARCHIVE.ORG " : GOSUB 6010
4075 LETS RSBR, RSBT, RSBC = 1, "READING ROM LIST", "white" : GOSUB 6110
4080 LETS RSBR, RSBT, RSBC = 2, UCASE(RSID), "grey" : GOSUB 6110
4085 GOSUB 6310
4090 LETS RSGUIDE, RSKEYS = "ASKING ARCHIVE.ORG FOR THE ROMS", "PLEASE WAIT...  Y:EXIT"
4095 GOSUB 5810 : GOSUB 5860
4100 SHOW
4105 RETURN

4106 REM item ready: count ROMs per index letter, open a letter that has ROMs
4110 LET RSTOTAL = 0
4120 FOR RSI = 0 TO RSIDXN - 1
4125   LET RSLW1 = RSPFX + LCASE(SUBSTR(RSIDX, RSI, 1))
4130   LET RSLCNT[RSI] = LEN(IAFILES(RSID, RSLW1 + "*.zip")) - LEN(IAFILES(RSID, RSLW1 + "*/*.zip"))
4140   LET RSTOTAL = RSTOTAL + RSLCNT[RSI]
4150 NEXT RSI
4160 IF RSTOTAL = 0 THEN LET RSERR = "NO ROMS FOUND" : GOSUB 4710 : RETURN
4170 IF RSLCNT[RSLET] = 0 THEN LET RSDIR = 1 : GOSUB 4410
4180 GOSUB 4210
4182 IF RSCNT = 0 && RSTOTAL > 0 THEN LET RSDIR = 1 : GOSUB 4410 : GOTO 4180
4185 IF RSTOTAL <= 0 THEN LET RSERR = "NO ROMS UNDER 2 GB" : GOSUB 4710 : RETURN
4190 LET RSMODE = 1 : GOSUB 4610
4200 RETURN

4205 REM load the ROMs of letter RSLET (sorted, filtered); RSATEND = 1 selects the last one
4210 LET RSLW1 = RSPFX + LCASE(SUBSTR(RSIDX, RSLET, 1))
4212 LET RSFILES = IAFILES(RSID, RSLW1 + "*.zip")
4214 IF LEN(RSFILES) > 0 THEN GOSUB 4280
4216 LET RSTOTAL = RSTOTAL + LEN(RSFILES) - RSLCNT[RSLET]
4218 LET RSLCNT[RSLET] = LEN(RSFILES)
4220 LETS RSCNT, RSSEL, RSTOP = LEN(RSFILES), 0, 0
4225 IF RSATEND = 1 THEN LETS RSSEL, RSTOP = MAX(0, RSCNT - 1), MAX(0, RSCNT - RSROWS)
4228 LET RSATEND = 0
4230 DIM RSDL[MAX(RSCNT, 1)]
4240 IF RSCNT = 0 THEN RETURN
4250 CALL SORT(RSFILES)
4260 GOSUB 5210
4270 RETURN

4275 REM keep only zips directly in RSPFX (no "samples/x.zip" when RSPFX is "") up to RSMAXSZ
4280 CALL SETCPU(500) : LETS RSKN, RSALLN = 0, LEN(RSFILES)
4281 DIM RSKEEP[RSALLN]
4282 FOR RSI = 0 TO RSALLN - 1
4283   LET RSF = RSFILES[RSI]
4284   IF COUNTMEMBERS(SUBSTR(RSF, LEN(RSPFX), LEN(RSF) - LEN(RSPFX)), "/") <= 1 && IAFILEINFO(RSID, RSF, "size") <= RSMAXSZ THEN LET RSKEEP[RSKN] = RSF : LET RSKN = RSKN + 1
4285 NEXT RSI
4286 CALL SETCPU(100)
4287 IF RSKN = RSALLN THEN LET RSFILES = RSKEEP : RETURN
4288 IF RSKN = 0 THEN LET RSFILES = "" : RETURN
4289 DIM RSFILES[RSKN]
4290 FOR RSI = 0 TO RSKN - 1
4292   LET RSFILES[RSI] = RSKEEP[RSI]
4294 NEXT RSI
4298 RETURN

4300 REM move the letter cursor in direction RSDIR and show its ROMs
4310 LET RSOLD = RSLET : GOSUB 4410
4320 IF RSLET = RSOLD THEN LET RSATEND = 0 : RETURN
4330 GOSUB 4210
4332 IF RSCNT = 0 && RSTOTAL > 0 THEN GOSUB 4410 : GOTO 4330
4334 IF RSTOTAL <= 0 THEN LET RSERR = "NO ROMS UNDER 2 GB" : GOSUB 4710 : RETURN
4340 GOSUB 5060 : GOSUB 5110 : GOSUB 5310 : GOSUB 5710
4350 SHOW
4360 RETURN

4400 REM RSLET = next letter with ROMs in direction RSDIR (wraps); unchanged if none
4410 FOR RSK = 1 TO RSIDXN - 1
4420   LET RSI = MOD(RSLET + RSDIR * RSK + RSIDXN, RSIDXN)
4430   IF RSLCNT[RSI] > 0 THEN LET RSLET = RSI : GOTO 4450
4440 NEXT RSK
4450 RETURN

4500 REM B: queue the highlighted ROM for download (runs in the background)
4510 IF RSCNT = 0 THEN RETURN
4520 LET RSF = RSFILES[RSSEL] : GOSUB 5410
4530 GOSUB 5440
4540 IF RSQPOS >= 0 THEN LETS RSMSG, RSMSGCOL, RSMSGT = RSNM + " IS ALREADY COMING", "cyan", 8 : RETURN
4550 LET RSIX2 = RSSEL : GOSUB 5460
4560 IF RSDLV = 1 THEN LETS RSMSG, RSMSGCOL, RSMSGT = RSNM + " IS ALREADY HERE", "light_green", 8 : RETURN
4570 IF RSQN >= RSQMAX THEN LETS RSMSG, RSMSGCOL, RSMSGT = "TOO MANY DOWNLOADS, WAIT A BIT", "orange", 8 : RETURN
4580 CALL IAFILEDOWNLOAD(RSID, RSF)
4590 LETS RSQID[RSQN], RSQFILE[RSQN], RSQNAME[RSQN] = RSID, RSF, RSNM
4595 LET RSQN = RSQN + 1
4600 IF ISMEMBER(RSFAILED, RSID + ":" + RSF, "|") THEN LET RSFAILED = REMOVEMEMBER(RSFAILED, RSID + ":" + RSF, "|")
4602 LETS RSMSG, RSMSGCOL, RSMSGT = "GETTING " + RSNM, "cyan", 8
4604 GOSUB 5310 : GOSUB 5710 : GOSUB 5810
4606 SHOW
4608 RETURN

4609 REM full redraw of the browsing screen (mode 1)
4610 GOSUB 5010 : GOSUB 5250
4620 GOSUB 5310 : GOSUB 5710
4630 LET RSGUIDE = "PICK A LETTER, THEN A ROM"
4640 LET RSKEYS = IIF(RSSRCN > 1, "<>:ABC L/R:PAGE X:SRC B:GET Y:EXIT", "<>:LETTER  L/R:PAGE  B:GET  Y:EXIT")
4650 GOSUB 5810 : GOSUB 5860
4660 SHOW
4670 RETURN

4700 REM item error box (mode 2), reason in RSERR; B retries
4710 LET RSMODE = 2 : GOSUB 5010 : GOSUB 5250
4720 LET RSBOXT = " ERROR " : GOSUB 6010
4730 LETS RSBR, RSBT, RSBC = 1, "CANNOT READ THE ITEM", "light_red" : GOSUB 6110
4740 LETS RSBR, RSBT, RSBC = 2, UCASE(RSID), "grey" : GOSUB 6110
4750 LETS RSBR, RSBT, RSBC = 4, "STATUS: " + RSERR, "light_grey" : GOSUB 6110
4760 LET RSGUIDE = "CHECK YOUR CONNECTION AND RETRY"
4765 LET RSKEYS = IIF(RSSRCN > 1, "B:RETRY  X:NEXT SOURCE  Y:EXIT", "B:RETRY  Y:EXIT")
4770 GOSUB 5810 : GOSUB 5860
4780 SHOW
4790 RETURN

4800 REM exit warning box (mode 3): downloads are still running
4810 LET RSMODE = 3 : LET RSBOXT = " LEAVE? " : GOSUB 6010
4815 GOSUB 4850
4820 LETS RSBR, RSBT, RSBC = 2, "THEY MAY NOT FINISH", "light_grey" : GOSUB 6110
4825 LETS RSBR, RSBT, RSBC = 4, "Y:LEAVE   ANY KEY:STAY", "yellow" : GOSUB 6110
4830 LET RSKEYS = "Y:LEAVE  ANY OTHER KEY:STAY" : GOSUB 5860
4835 SHOW
4840 RETURN

4845 REM exit box row 1: live count of running downloads
4850 LETS RSBR, RSBT, RSBC = 1, STR(RSQN) + IIF(RSQN = 1, " DOWNLOAD", " DOWNLOADS") + " RUNNING", "orange" : GOSUB 6110
4860 RETURN

4900 REM dismiss the exit warning, back to browsing
4910 LET RSMODE = 1 : GOSUB 4610
4920 RETURN

5000 REM banner (row 0), source tab (row 1), letter index (row 2), separators
5010 FGCOLOR "light_blue" : PRINT 0, 0, RSBLANK, 1, 0
5020 PRINT INT((RSW - 1 - LEN(RSTITLE)) / 2), 0, RSTITLE, 1, 0
5030 GOSUB 5060 : GOSUB 5110
5040 FGCOLOR "light_blue" : PRINT 0, 3, RSLINE, 0, 0 : PRINT 0, RSH - 3, RSLINE, 0, 0
5050 RETURN

5055 REM source tab: [n/m] item title on the left, ROM total on the right
5060 PRINT 0, 1, RSBLANK, 0, 0
5065 LET RSTT = RSID
5070 IF IASTATUS(RSID) = "READY" THEN LET RSTT = IAINFO(RSID, "title")
5072 IF TRIM(RSTT) = "" THEN LET RSTT = RSID
5075 LET RSRT = IIF(RSTOTAL > 0, STR(RSTOTAL) + " ROMS", "")
5080 LET RSLT = IIF(RSSRCN > 1, STR(RSSRC + 1) + "/" + STR(RSSRCN) + " ", "") + UCASE(RSTT)
5085 FGCOLOR "white" : PRINT 0, 1, SUBSTR(RSLT, 0, MAX(1, RSW - 3 - LEN(RSRT))), 0, 0
5090 IF RSRT != "" THEN FGCOLOR "cyan" : PRINT RSW - 1 - LEN(RSRT), 1, RSRT, 0, 0
5095 FGCOLOR "light_blue"
5100 RETURN

5105 REM letter index: current = inverted yellow, with ROMs = white, empty = dark grey
5110 PRINT 0, 2, RSBLANK, 0, 0
5115 IF RSMODE != 1 THEN RETURN
5120 LET RSIW = MIN(RSIDXN, RSW - 3)
5125 LET RSIS = MAX(0, MIN(RSIDXN - RSIW, RSLET - INT(RSIW / 2)))
5130 LET RSIX = INT((RSW - 1 - RSIW) / 2)
5135 FGCOLOR "white"
5140 IF RSIS > 0 THEN PRINT RSIX - 1, 2, "<", 0, 0
5145 IF RSIS + RSIW < RSIDXN THEN PRINT RSIX + RSIW, 2, ">", 0, 0
5150 FOR RSI = 0 TO RSIW - 1
5155   LET RSJ = RSIS + RSI
5160   IF RSJ = RSLET THEN FGCOLOR "yellow" : PRINT RSIX + RSI, 2, SUBSTR(RSIDX, RSJ, 1), 1, 0
       ELSE FGCOLOR IIF(RSLCNT[RSJ] > 0, "white", "darkgrey") : PRINT RSIX + RSI, 2, SUBSTR(RSIDX, RSJ, 1), 0, 0
5165 NEXT RSI
5170 FGCOLOR "light_blue"
5175 RETURN

5200 REM forget the cached "downloaded" state of the current letter's ROMs
5210 IF RSCNT = 0 THEN RETURN
5220 FOR RSI = 0 TO RSCNT - 1
5230   LET RSDL[RSI] = -1
5240 NEXT RSI
5245 RETURN

5248 REM clear the content area (list + info panel)
5250 FOR RSR = RSLISTTOP TO RSINFOBOT
5255   PRINT 0, RSR, RSBLANK, 0, 0
5260 NEXT RSR
5265 RETURN

5300 REM draw the visible window of the ROM list + its separator
5310 FOR RSR = 0 TO RSROWS - 1
5320   LET RSIX2 = RSTOP + RSR
5330   IF RSIX2 < RSCNT THEN GOSUB 5360 ELSE PRINT 0, RSLISTTOP + RSR, RSBLANK, 0, 0
5340 NEXT RSR
5345 GOSUB 5400
5350 RETURN

5355 REM one ROM row (index RSIX2, screen row RSR): name + live tag
5360 LET RSF = RSFILES[RSIX2] : GOSUB 5410
5362 GOSUB 5440
5364 IF RSQPOS >= 0 THEN LET RSQS = IAFILEDOWNLOADSTATUS(RSID, RSF) : LETS RSTAG, RSTC = IIF(RSQS = "QUEUED", "QUEUED", STR(INT(IAFILEDOWNLOADPROGRESS(RSID, RSF))) + "%"), "cyan" : GOTO 5370
5366 IF ISMEMBER(RSFAILED, RSID + ":" + RSF, "|") THEN LETS RSTAG, RSTC = "FAILED", "light_red" : GOTO 5370
5368 GOSUB 5460 : LETS RSTAG, RSTC = IIF(RSDLV = 1, "HAVE", IIF(RSDLV = 2, "UPDATE", "NEW")), IIF(RSDLV = 1, "light_green", IIF(RSDLV = 2, "orange", "white"))
5370 LET RSTXT = SUBSTR(RSNM + RSBLANK, 0, RSLW - 2 - LEN(RSTAG))
5375 IF RSIX2 = RSSEL THEN FGCOLOR "yellow" : PRINT 0, RSLISTTOP + RSR, " " + RSTXT + " " + RSTAG + " ", 1, 0
     ELSE FGCOLOR "light_blue" : PRINT 0, RSLISTTOP + RSR, " " + RSTXT + " ", 0, 0 : FGCOLOR RSTC : PRINT RSLW - LEN(RSTAG), RSLISTTOP + RSR, RSTAG + " ", 0, 0
5380 FGCOLOR "light_blue"
5390 RETURN

5395 REM list separator: "G: 87 ROMS" on the left, "^ 3/87 v" on the right
5400 FGCOLOR "light_blue" : PRINT 0, RSSEPROW, RSLINE, 0, 0
5402 FGCOLOR "white" : PRINT 1, RSSEPROW, " " + SUBSTR(RSIDX, RSLET, 1) + ": " + STR(RSCNT) + " ROMS ", 0, 0
5404 IF RSCNT > 0 THEN LET RSPOS = " " + IIF(RSTOP > 0, "^", "-") + " " + STR(RSSEL + 1) + "/" + STR(RSCNT) + " " + IIF(RSTOP + RSROWS < RSCNT, "v", "-") + " " : PRINT RSW - 2 - LEN(RSPOS), RSSEPROW, RSPOS, 0, 0
5406 FGCOLOR "light_blue"
5408 RETURN

5409 REM RSNM = display name of item file RSF (no folder, no .zip, uppercase)
5410 LET RSNM = RSF
5412 IF LEN(RSPFX) > 0 && LEN(RSNM) > LEN(RSPFX) THEN LET RSNM = SUBSTR(RSNM, LEN(RSPFX), LEN(RSNM) - LEN(RSPFX))
5414 IF LCASE(SUBSTR(RSNM, MAX(0, LEN(RSNM) - 4), 4)) = ".zip" THEN LET RSNM = SUBSTR(RSNM, 0, LEN(RSNM) - 4)
5416 LET RSNM = UCASE(RSNM)
5418 RETURN

5439 REM RSQPOS = queue position of RSID/RSF, -1 if it isn't downloading
5440 LET RSQPOS = -1
5442 IF RSQN = 0 THEN RETURN
5444 FOR RSQ = 0 TO RSQN - 1
5446   IF RSQFILE[RSQ] = RSF && RSQID[RSQ] = RSID THEN LET RSQPOS = RSQ : GOTO 5449
5448 NEXT RSQ
5449 RETURN

5459 REM RSDLV = downloaded state of ROM RSIX2 (0 no, 1 same md5, 2 different), cached
5460 IF RSDL[RSIX2] < 0 THEN LET RSDL[RSIX2] = IAFILEINFO(RSID, RSFILES[RSIX2], "downloaded")
5464 LET RSDLV = RSDL[RSIX2]
5468 RETURN

5500 REM move the selection by RSDELTA; a single step past either end changes letter
5510 IF RSCNT = 0 THEN RETURN
5512 IF RSDELTA = -1 && RSSEL = 0 THEN LETS RSDIR, RSATEND = -1, 1 : GOSUB 4310 : RETURN
5514 IF RSDELTA = 1 && RSSEL = RSCNT - 1 THEN LET RSDIR = 1 : GOSUB 4310 : RETURN
5520 LET RSSEL = MAX(0, MIN(RSCNT - 1, RSSEL + RSDELTA))
5530 IF RSSEL < RSTOP THEN LET RSTOP = RSSEL
5540 IF RSSEL >= RSTOP + RSROWS THEN LET RSTOP = RSSEL - RSROWS + 1
5550 GOSUB 5310 : GOSUB 5710
5555 SHOW
5560 RETURN

5700 REM info panel of the highlighted ROM: file, size, state
5710 IF RSINFOTOP > RSINFOBOT THEN RETURN
5712 FOR RSIR = RSINFOTOP TO RSINFOBOT
5714   PRINT 0, RSIR, RSBLANK, 0, 0
5716 NEXT RSIR
5718 IF RSCNT = 0 THEN RETURN
5720 LET RSF = RSFILES[RSSEL] : LET RSIX2 = RSSEL : GOSUB 5460
5722 LET RSSZ = IAFILEINFO(RSID, RSF, "size") : GOSUB 5910
5724 LETS RSLBL, RSVAL, RSVC, RSLR = "FILE : ", RSF, "white", RSINFOTOP : GOSUB 5770
5726 LETS RSLBL, RSVAL, RSVC, RSLR = "SIZE : ", RSSZTXT, "white", RSINFOTOP + 1 : GOSUB 5770
5728 GOSUB 5440
5730 LET RSVAL = IIF(RSDLV = 1, "IN YOUR DOWNLOADS FOLDER", IIF(RSDLV = 2, "NEWER VERSION ONLINE", "NOT DOWNLOADED YET"))
5732 IF RSQPOS >= 0 THEN LET RSVAL = "DOWNLOADING..."
5734 LETS RSLBL, RSVC, RSLR = "STATE: ", IIF(RSQPOS >= 0, "cyan", IIF(RSDLV = 1, "light_green", IIF(RSDLV = 2, "orange", "light_grey"))), RSINFOTOP + 2 : GOSUB 5770
5740 RETURN

5765 REM info row: cyan label RSLBL + value RSVAL in RSVC at row RSLR (clipped to the panel)
5770 IF RSLR > RSINFOBOT THEN RETURN
5772 FGCOLOR "cyan" : PRINT 1, RSLR, RSLBL, 0, 0
5774 FGCOLOR RSVC : PRINT 1 + LEN(RSLBL), RSLR, SUBSTR(RSVAL, 0, MAX(1, RSW - 2 - LEN(RSLBL))), 0, 0
5776 FGCOLOR "light_blue"
5778 RETURN

5800 REM status strip (row H-2): message > first running download > guide, + blinking cursor
5810 LETS RSSTRIP, RSSC = RSGUIDE, "yellow"
5815 IF RSQN > 0 THEN LETS RSSTRIP, RSSC = "DL " + STR(RSQN) + ": " + RSQNAME[0] + " " + STR(INT(IAFILEDOWNLOADPROGRESS(RSQID[0], RSQFILE[0]))) + "%", "cyan"
5820 IF RSMSGT > 0 THEN LETS RSSTRIP, RSSC = RSMSG, RSMSGCOL
5825 LET RSSTRIP = SUBSTR(RSSTRIP, 0, RSW - 3)
5830 FGCOLOR RSSC : PRINT 0, RSH - 2, RSBLANK, 0, 0 : PRINT 0, RSH - 2, RSSTRIP, 0, 0
5835 FGCOLOR "light_blue" : PRINT LEN(RSSTRIP) + 1, RSH - 2, " ", RSCUR, 0
5840 RETURN

5855 REM key footer (row H-1, inverted)
5860 FGCOLOR "light_blue" : PRINT 0, RSH - 1, RSBLANK, 1, 0
5865 PRINT 0, RSH - 1, SUBSTR(" " + RSKEYS, 0, RSW - 1), 1, 0
5870 RETURN

5900 REM format RSSZ (bytes) into RSSZTXT ("2.6 MB" / "512 KB")
5910 IF RSSZ >= 1048576 THEN LET RSSZTXT = STR(INT(RSSZ / 1048576)) + "." + STR(INT(MOD(INT(RSSZ), 1048576) * 10 / 1048576)) + " MB"
     ELSE LET RSSZTXT = STR(INT(RSSZ / 1024)) + " KB"
5920 RETURN

6000 REM centered box with an inverted frame and a yellow title RSBOXT
6010 FGCOLOR "light_blue" : PRINT RSBX, RSBY, SUBSTR(RSBLANK, 0, RSBW), 1, 0
6020 FOR RSBRW = 1 TO RSBH - 2
6030   PRINT RSBX, RSBY + RSBRW, " ", 1, 0 : PRINT RSBX + 1, RSBY + RSBRW, SUBSTR(RSBLANK, 0, RSBW - 2), 0, 0 : PRINT RSBX + RSBW - 1, RSBY + RSBRW, " ", 1, 0
6040 NEXT RSBRW
6050 PRINT RSBX, RSBY + RSBH - 1, SUBSTR(RSBLANK, 0, RSBW), 1, 0
6060 FGCOLOR "yellow" : PRINT RSBX + INT((RSBW - LEN(RSBOXT)) / 2), RSBY, RSBOXT, 1, 0
6070 FGCOLOR "light_blue"
6080 RETURN

6100 REM centered box text RSBT in color RSBC at box row RSBR (1..RSBH-2)
6110 PRINT RSBX + 2, RSBY + RSBR, SUBSTR(RSBLANK, 0, RSBIW), 0, 0
6120 LET RSBT = SUBSTR(RSBT, 0, RSBIW)
6130 FGCOLOR RSBC : PRINT RSBX + INT((RSBW - LEN(RSBT)) / 2), RSBY + RSBR, RSBT, 0, 0
6140 FGCOLOR "light_blue"
6150 RETURN

6300 REM sliding spinner on box row 3
6310 LETS RSBR, RSBT, RSBC = 3, RSSPIN[MOD(RSTICK, LEN(RSSPIN))], "light_green" : GOSUB 6110
6320 RETURN
